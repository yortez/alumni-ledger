rder-[#e0e0e0] bg-[#f5f5f7]\" data-kid=\"1-2\" data-name=\"main navigation bar\">\n<div class=\"mx-auto flex h-[52px] max-w-[1440px] items-center gap-1 px-8\" data-kid=\"1-2-1\" data-name=\"navigation item row\">\n<a aria-current=\"page\" class=\"rounded-[8px] bg-white px-3 py-1.5 text-[12px] font-semibold text-[#1d1d1f]\" data-kid=\"1-2-1-1\" data-name=\"active overview nav link\" href=\"#\">Overview</a>\n<a class=\"rounded-[8px] px-3 py-1.5 text-[12px] text-[#333]\" data-kid=\"1-2-1-2\" data-name=\"graduates nav link\" href=\"#\">Graduates</a>\n<a class=\"rounded-[8px] px-3 py-1.5 text-[12px] text-[#333]\" data-kid=\"1-2-1-3\" data-name=\"announcements nav link\" href=\"#\">Announcements</a>\n<a class=\"rounded-[8px] px-3 py-1.5 text-[12px] text-[#333]\" data-kid=\"1-2-1-4\" data-name=\"surveys nav link\" href=\"#\">Surveys</a>\n<a class=\"rounded-[8px] px-3 py-1.5 text-[12px] text-[#333]\" data-kid=\"1-2-1-5\" data-name=\"jobs nav link\" href=\"#\">Jobs</a>\n<a class=\"rounded-[8px] px-3 py-1.5 text-[12px] text-[#333]\" data-kid=\"1-2-1-6\" data-name=\"administrators nav link\" href=\"#\">Administrators</a>\n<a class=\"rounded-[8px] px-3 py-1.5 text-[12px] text-[#333]\" data-kid=\"1-2-1-7\" data-name=\"roles nav link\" href=\"#\">Roles</a>\n</div>\n</nav>\n<main class=\"mx-auto max-w-[1440px] px-20 pb-16 pt-8\" data-kid=\"1-3\" data-name=\"main content area\">\n<div class=\"flex h-16 items-baseline justify-between gap-6\" data-kid=\"1-3-1\" data-name=\"page header row\">\n<h1 class=\"text-[40px] font-semibold leading-[1.1] tracking-[-0.022em]\" data-kid=\"1-3-1-1\" data-name=\"page title heading\">Overview</h1>\n<p class=\"text-[17px] text-[#7a7a7a]\" data-kid=\"1-3-1-2\" data-name=\"user role subtitle\">Super administrator</p>\n</div>\n<div class=\"grid grid-cols-[840px_416px] gap-6\" data-kid=\"1-3-2\" data-name=\"main content grid layout\">\n<div class=\"space-y-6\" data-kid=\"1-3-2-1\" data-name=\"left column section stack\">\n<section aria-labelledby=\"graduates-panel\" class=\"flex min-h-[200px] flex-col justify-between rounded-[18px] border border-[#e0e0e0] bg-white p-6\" data-kid=\"1-3-2-1-1\" data-name=\"graduates stats card\">\n<div class=\"flex items-start justify-between gap-6\" data-kid=\"1-3-2-1-1-1\" data-name=\"card header with title and link\">\n<h2 class=\"text-[21px] font-semibold tracking-[-0.011em]\" data-kid=\"1-3-2-1-1-1-1\" data-name=\"card title heading\" id=\"graduates-panel\">Graduates</h2>\n<a class=\"inline-flex items-center gap-1 text-[14px] font-semibold text-[#0066cc]\" data-kid=\"1-3-2-1-1-1-2\" data-name=\"open master list link\" href=\"#\">Open master list<i aria-hidden=\"true\" class=\"icon-chevron-right\" data-kid=\"1-3-2-1-1-1-2-1\" data-name=\"right chevron icon\"></i></a>\n</div>\n<dl class=\"mt-6 flex items-start gap-20\" data-kid=\"1-3-2-1-1-2\" data-name=\"stats display container\">\n<div data-kid=\"1-3-2-1-1-2-1\" data-name=\"graduates stat block\">\n<dd class=\"text-[40px] font-semibold leading-none tabular-nums tracking-[-0.022em]\" data-kid=\"1-3-2-1-1-2-1-1\" data-name=\"graduates stat number\">1,284</dd>\n<dt class=\"mt-2 text-[14px] text-[#7a7a7a]\" data-kid=\"1-3-2-1-1-2-1-2\" data-name=\"stat label text\">Graduate records</dt>\n</div>\n<div data-kid=\"1-3-2-1-1-2-2\" data-name=\"accounts claimed stat block\">\n<dd class=\"text-[40px] font-semibold leading-none tabular-nums tracking-[-0.022em]\" data-kid=\"1-3-2-1-1-2-2-1\" data-name=\"accounts claimed stat number\">963</dd>\n<dt class=\"mt-2 text-[14px] text-[#7a7a7a]\" data-kid=\"1-3-2-1-1-2-2-2\" data-name=\"stat label text\">Accounts claimed</dt>\n</div>\n</dl>\n</section>\n<div class=\"grid grid-cols-2 gap-6\" data-kid=\"1-3-2-1-2\" data-name=\"side-by-side cards grid\">\n<section aria-labelledby=\"surveys-panel\" class=\"flex min-h-[184px] flex-col rounded-[18px] border border-[#e0e0e0] bg-white p-6\" data-kid=\"1-3-2-1-2-1\" data-name=\"surveys stats card\">\n<div class=\"flex items-start justify-between gap-4\" data-kid=\"1-3-2-1-2-1-1\" data-name=\"card header with title and link\">\n<h2 class=\"text-[17px] font-semibold\" data-kid=\"1-3-2-1-2-1-1-1\" data-name=\"card title heading\" id=\"surveys-panel\">Surveys</h2>\n<a class=\"inline-flex items-center gap-1 whitespace-nowrap text-[14px] font-semibold text-[#0066cc]\" data-kid=\"1-3-2-1-2-1-1-2\" data-name=\"manage surveys link\" href=\"#\">Manage surveys<i aria-hidden=\"true\" class=\"icon-chevron-right\" data-kid=\"1-3-2-1-2-1-1-2-1\" data-name=\"right chevron icon\"></i></a>\n</div>\n<p class=\"mt-8 text-[32px] font-semibold leading-none tabular-nums tracking-[-0.02em]\" data-kid=\"1-3-2-1-2-1-2\" data-name=\"open surveys stat number\">3</p>\n<p class=\"mt-2 text-[14px] text-[#7a7a7a]\" data-kid=\"1-3-2-1-2-1-3\" data-name=\"stat label text\">Open surveys</p>\n<p class=\"mt-auto pt-4 text-[14px] leading-[1.43] text-[#333]\" data-kid=\"1-3-2-1-2-1-4\" data-name=\"card description text\">Set audiences, review responses, and close surveys.</p>\n</section>\n<section aria-labelledby=\"jobs-panel\" class=\"flex min-h-[184px] flex-col rounded-[18px] border border-[#e0e0e0] bg-white p-6\" data-kid=\"1-3-2-1-2-2\" data-name=\"jobs stats card\">\n<div class=\"flex items-start justify-between gap-4\" data-kid=\"1-3-2-1-2-2-1\" data-name=\"card header with title and link\">\n<h2 class=\"text-[17px] font-semibold\" data-kid=\"1-3-2-1-2-2-1-1\" data-name=\"card title heading\" id=\"jobs-panel\">Jobs</h2>\n<a class=\"inline-flex items-center gap-1 whitespace-nowrap text-[14px] font-semibold text-[#0066cc]\" data-kid=\"1-3-2-1-2-2-1-2\" data-name=\"manage jobs link\" href=\"#\">Manage jobs<i aria-hidden=\"true\" class=\"icon-chevron-right\" data-kid=\"1-3-2-1-2-2-1-2-1\" data-name=\"right chevron icon\"></i></a>\n</div>\n<p class=\"mt-8 text-[32px] font-semibold leading-none tabular-nums tracking-[-0.02em]\" data-kid=\"1-3-2-1-2-2-2\" data-name=\"active jobs stat number\">7</p>\n<p class=\"mt-2 text-[14px] text-[#7a7a7a]\" data-kid=\"1-3-2-1-2-2-3\" data-name=\"stat label text\">Active jobs</p>\n<p class=\"mt-auto pt-4 text-[14px] leading-[1.43] text-[#333]\" data-kid=\"1-3-2-1-2-2-4\" data-name=\"card description text\">Publish opportunities and review applications.</p>\n</section>\n</div>\n</div>\n<aside class=\"space-y-6\" data-kid=\"1-3-2-2\" data-name=\"right aside section stack\">\n<section aria-labelledby=\"announcements-panel\" class=\"flex min-h-[176px] flex-col rounded-[18px] border border-[#e0e0e0] bg-white p-6\" data-kid=\"1-3-2-2-1\" data-name=\"announcements card\">\n<div class=\"flex items-start justify-between gap-4\" data-kid=\"1-3-2-2-1-1\" data-name=\"card header row\">\n<h2 class=\"text-[21px] font-semibold tracking-[-0.011em]\" data-kid=\"1-3-2-2-1-1-1\" data-name=\"card title heading\" id=\"announcements-panel\">Announcements</h2>\n</div>\n<p class=\"mt-3 max-w-[300px] text-[14px] leading-[1.47] text-[#333]\" data-kid=\"1-3-2-2-1-2\" data-name=\"card description text\">Create and publish announcements for alumni.</p>\n<a class=\"mt-auto inline-flex items-center gap-1 pt-4 text-[14px] font-semibold text-[#0066cc]\" data-kid=\"1-3-2-2-1-3\" data-name=\"manage announcements link\" href=\"#\">Manage announcements<i aria-hidden=\"true\" class=\"icon-chevron-right\" data-kid=\"1-3-2-2-1-3-1\" data-name=\"right chevron icon\"></i></a>\n</section>\n<section aria-labelledby=\"access-panel\" class=\"rounded-[18px] border border-[#e0e0e0] bg-white p-6\" data-kid=\"1-3-2-2-2\" data-name=\"access settings card\">\n<h2 class=\"text-[17px] font-semibold\" data-kid=\"1-3-2-2-2-1\" data-name=\"card title heading\" id=\"access-panel\">Access</h2>\n<div class=\"mt-3 border-t border-[#e0e0e0]\" data-kid=\"1-3-2-2-2-2\" data-name=\"access menu list container\">\n<a class=\"flex items-start justify-between gap-4 border-b border-[#f0f0f0] py-4\" data-kid=\"1-3-2-2-2-2-1\" data-name=\"administrator accounts menu item\" href=\"#\">\n<span class=\"min-w-0\" data-kid=\"1-3-2-2-2-2-1-1\" data-name=\"menu item text container\">\n<span class=\"block text-[14px] font-semibold\" data-kid=\"1-3-2-2-2-2-1-1-1\" data-name=\"menu item title\">Administrator accounts</span>\n<span class=\"mt-1 block text-[13px] leading-[1.43] text-[#7a7a7a]\" data-kid=\"1-3-2-2-2-2-1-1-2\" data-name=\"menu item description\">Create administrators and assign their roles.</span>\n</span>\n<i aria-hidden=\"true\" class=\"icon-chevron-right mt-0.5 shrink-0 text-[12px] text-[#0066cc]\" data-kid=\"1-3-2-2-2-2-1-2\" data-name=\"right chevron icon\"></i>\n</a>\n<a class=\"flex items-start justify-between gap-4 py-4\" data-kid=\"1-3-2-2-2-2-2\" data-name=\"role definitions menu item\" href=\"#\">\n<span class=\"min-w-0\" data-kid=\"1-3-2-2-2-2-2-1\" data-name=\"menu item text container\">\n<span class=\"block text-[14px] font-semibold\" data-kid=\"1-3-2-2-2-2-2-1-1\" data-name=\"menu item title\">Role definitions</span>\n<span class=\"mt-1 block text-[13px] leading-[1.43] text-[#7a7a7a]\" data-kid=\"1-3-2-2-2-2-2-1-2\" data-name=\"menu item description\">Create roles and choose their module permissions.</span>\n</span>\n<i aria-hidden=\"true\" class=\"icon-chevron-right mt-0.5 shrink-0 text-[12px] text-[#0066cc]\" data-kid=\"1-3-2-2-2-2-2-2\" data-name=\"right chevron icon\"></i>\n</a>\n</div>\n</section>\n</aside>\n</div>\n</main>\n<footer class=\"mt-auto border-t border-[#e0e0e0]\" data-kid=\"1-4\" data-name=\"footer bar\">\n<div class=\"mx-auto flex max-w-[1440px] items-center px-8 py-4 text-[12px] text-[#7a7a7a]\" data-kid=\"1-4-1\" data-name=\"footer inner content row\">\n<span data-kid=\"1-4-1-1\" data-name=\"footer copyright/system name text\">Alumni Tracer Management System</span>\n</div>\n</footer>\n</div>",
