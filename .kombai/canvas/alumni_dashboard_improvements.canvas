      "html": "<div class=\"flex min-h-screen flex-col bg-[#f5f5f7] text-[#1d1d1f] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Inter',system-ui,-apple-system,'Segoe UI',sans-serif;font-feature-settings:'ss03'\">\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<header class=\"bg-black\" data-kid=\"1-1\" data-name=\"header bar with black app bar\">\n<div class=\"mx-auto flex h-16 max-w-[1440px] items-center gap-3 px-8\" data-kid=\"1-1-1\" data-name=\"header toolbar container\">\n<span class=\"grid size-7 shrink-0 place-items-center rounded-[6px] bg-white text-[11px] font-semibold tracking-tight text-black\" data-kid=\"1-1-1-1\" data-name=\"app logo monogram badge\">AT</span>\n<a class=\"truncate text-[13px] text-white\" data-kid=\"1-1-1-2\" data-name=\"app name title link\" href=\"#\">Alumni Tracer Management System</a>\n<span class=\"h-4 w-px shrink-0 bg-white/25\" data-kid=\"1-1-1-3\" data-name=\"header divider line\"></span>\n<span class=\"text-[13px] text-white/60\" data-kid=\"1-1-1-4\" data-name=\"current view label text\">Dashboard</span>\n<div class=\"ml-auto flex items-center gap-1\" data-kid=\"1-1-1-5\" data-name=\"header action controls group\">\n<button aria-label=\"Notifications, 2 unread\" class=\"relative grid size-11 place-items-center rounded-full text-[18px] text-white/85\" data-kid=\"1-1-1-5-1\" data-name=\"notifications bell button\" type=\"button\">\n<i aria-hidden=\"true\" class=\"icon-bell\" data-kid=\"1-1-1-5-1-1\" data-name=\"bell notification icon\"></i>\n<span class=\"absolute right-2 top-2 grid min-w-[15px] place-items-center rounded-full bg-[#0066cc] px-1 text-[9px] font-semibold leading-[15px] text-white tabular-nums\" data-kid=\"1-1-1-5-1-2\" data-name=\"unread count badge\">2</span>\n</button>\n<button aria-expanded=\"false\" aria-label=\"Open application menu\" class=\"grid size-11 place-items-center rounded-full text-[18px] text-white/85\" data-kid=\"1-1-1-5-2\" data-name=\"application menu button\" type=\"button\">\n<i aria-hidden=\"true\" class=\"icon-menu\" data-kid=\"1-1-1-5-2-1\" data-name=\"menu hamburger icon\"></i>\n</button>\n<button aria-label=\"Account menu\" class=\"ml-1 grid size-8 place-items-center rounded-full bg-[#d2d2d7] text-[12px] font-semibold text-[#1d1d1f]\" data-kid=\"1-1-1-5-3\" data-name=\"account profile initial avatar button\" type=\"button\">D</button>\n</div>\n</div>\n</header>\n<main class=\"mx-auto max-w-[1440px] px-20 pb-16 pt-8\" data-kid=\"1-2\" data-name=\"main content area\">\n<section aria-label=\"Your alumni record\" data-kid=\"1-2-1\" data-name=\"alumni profile summary section\">\n<div class=\"flex items-center gap-5\" data-kid=\"1-2-1-1\" data-name=\"profile identity row\">\n<img alt=\"Danica R. Manalo\" class=\"size-14 shrink-0 rounded-full object-cover\" data-kid=\"1-2-1-1-1\" data-name=\"user profile photo\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/128?u=danica-manalo\"/>\n<div class=\"min-w-0\" data-kid=\"1-2-1-1-2\" data-name=\"profile name and role block\">\n<h1 class=\"text-[24px] font-semibold leading-[1.2] tracking-[-0.015em]\" data-kid=\"1-2-1-1-2-1\" data-name=\"profile full name heading\">Danica R. Manalo</h1>\n<p class=\"mt-1 text-[14px] text-[#333]\" data-kid=\"1-2-1-1-2-2\" data-name=\"profile job title and company subtitle\">Data Analyst, San Miguel Corporation</p>\n</div>\n<dl class=\"ml-4 flex items-start gap-10\" data-kid=\"1-2-1-1-3\" data-name=\"profile status attributes list\">\n<div data-kid=\"1-2-1-1-3-1\" data-name=\"graduate record status item\">\n<dt class=\"text-[13px] text-[#7a7a7a]\" data-kid=\"1-2-1-1-3-1-1\" data-name=\"graduate record label\">Graduate record</dt>\n<dd class=\"mt-1 text-[15px] font-semibold\" data-kid=\"1-2-1-1-3-1-2\" data-name=\"verified status value\">Verified</dd>\n</div>\n<div data-kid=\"1-2-1-1-3-2\" data-name=\"profile completeness status item\">\n<dt class=\"text-[13px] text-[#7a7a7a]\" data-kid=\"1-2-1-1-3-2-1\" data-name=\"profile status label\">Profile</dt>\n<dd class=\"mt-1 text-[15px] font-semibold\" data-kid=\"1-2-1-1-3-2-2\" data-name=\"complete status value\">Complete</dd>\n</div>\n</dl>\n<div class=\"ml-auto flex shrink-0 items-center gap-5\" data-kid=\"1-2-1-1-4\" data-name=\"profile action buttons group\">\n<a class=\"flex h-11 items-center rounded-full bg-[#0066cc] px-6 text-[14px] font-semibold text-white\" data-kid=\"1-2-1-1-4-1\" data-name=\"edit profile button\" href=\"#\">Edit profile</a>\n<a class=\"text-[14px] font-semibold text-[#0066cc]\" data-kid=\"1-2-1-1-4-2\" data-name=\"update career text link\" href=\"#\">Update career</a>\n</div>\n</div>\n<details class=\"mt-3\" data-kid=\"1-2-1-2\" data-name=\"profile details expandable disclosure\">\n<summary class=\"inline-flex cursor-pointer list-none items-center gap-1.5 text-[13px] font-semibold text-[#0066cc]\" data-kid=\"1-2-1-2-1\" data-name=\"profile details toggle summary\">\n                Profile details\n                <i aria-hidden=\"true\" class=\"icon-chevron-down\" data-kid=\"1-2-1-2-1-1\" data-name=\"chevron down icon\"></i>\n</summary>\n</details>\n</section>\n<div class=\"mt-6 grid grid-cols-[336px_920px] gap-6\" data-kid=\"1-2-2\" data-name=\"main dashboard two-column grid\">\n<section aria-labelledby=\"record-list-heading\" class=\"h-[592px] overflow-y-auto rounded-[18px] border border-[#e0e0e0] bg-white p-3\" data-kid=\"1-2-2-1\" data-name=\"records list sidebar panel\">\n<h2 class=\"sr-only\" data-kid=\"1-2-2-1-1\" data-name=\"records panel heading (screen-reader only)\" id=\"record-list-heading\">Available records</h2>\n<div class=\"flex h-14 items-center\" data-kid=\"1-2-2-1-2\" data-name=\"record filter tabs bar\">\n<div aria-label=\"Record type\" class=\"inline-flex rounded-full bg-[#f0f0f0] p-1\" data-kid=\"1-2-2-1-2-1\" data-name=\"record type filter ta