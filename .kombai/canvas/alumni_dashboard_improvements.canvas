tem\" type=\"button\">Surveys</button>\n<button class=\"flex h-16 items-center rounded-[8px] px-3 text-left text-[15px] text-[#333]\" data-kid=\"1-2-2-1-2-3\" data-name=\"workspace nav item\" type=\"button\">Announcements</button>\n<button class=\"flex h-16 items-center rounded-[8px] px-3 text-left text-[15px] text-[#333]\" data-kid=\"1-2-2-1-2-4\" data-name=\"workspace nav item\" type=\"button\">Jobs</button>\n</div>\n<div class=\"mt-4 flex flex-col border-t border-[#f0f0f0] pt-4\" data-kid=\"1-2-2-1-3\" data-name=\"admin navigation list\">\n<button class=\"flex h-16 items-center rounded-[8px] px-3 text-left text-[15px] text-[#333]\" data-kid=\"1-2-2-1-3-1\" data-name=\"admin nav item\" type=\"button\">Administrator accounts</button>\n<button class=\"flex h-16 items-center rounded-[8px] px-3 text-left text-[15px] text-[#333]\" data-kid=\"1-2-2-1-3-2\" data-name=\"admin nav item\" type=\"button\">Role definitions</button>\n</div>\n</section>\n<section aria-labelledby=\"detail-heading\" class=\"h-fit rounded-[18px] border border-[#e0e0e0] bg-white p-8\" data-kid=\"1-2-2-2\" data-name=\"detail panel card\">\n<h2 class=\"text-[28px] font-semibold tracking-[-0.018em]\" data-kid=\"1-2-2-2-1\" data-name=\"detail panel heading\" id=\"detail-heading\">Graduates</h2>\n<p class=\"mt-2 max-w-[560px] text-[17px] leading-[1.47] text-[#333]\" data-kid=\"1-2-2-2-2\" data-name=\"detail panel description\">Search, update, and import graduate records.</p>\n<dl class=\"mt-8 flex items-start gap-20 border-t border-[#e0e0e0] pt-6\" data-kid=\"1-2-2-2-3\" data-name=\"stats display row\">\n<div data-kid=\"1-2-2-2-3-1\" data-name=\"stat item container\">\n<dd class=\"text-[40px] font-semibold leading-none tabular-nums tracking-[-0.022em]\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"graduate records stat value\">1,284</dd>\n<dt class=\"mt-2 text-[14px] text-[#7a7a7a]\" data-kid=\"1-2-2-2-3-1-2\" data-name=\"stat label\">Graduate records</dt>\n</div>\n<div data-kid=\"1-2-2-2-3-2\" data-name=\"stat item container\">\n<dd class=\"text-[40px] font-semibold leading-none tabular-nums tracking-[-0.022em]\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"accounts claimed stat value\">963</dd>\n<dt class=\"mt-2 text-[14px] text-[#7a7a7a]\" data-kid=\"1-2-2-2-3-2-2\" data-name=\"stat label\">Accounts claimed</dt>\n</div>\n</dl>\n<a class=\"mt-8 inline-flex h-11 items-center rounded-full bg-[#0066cc] px-6 text-[14px] font-semibold text-white\" data-kid=\"1-2-2-2-4\" data-name=\"primary action button link\" href=\"#\">Open master list</a>\n</section>\n</div>\n</main>\n<footer class=\"mt-auto border-t border-[#e0e0e0]\" data-kid=\"1-3\" data-name=\"footer bar\">\n<div class=\"mx-auto flex max-w-[1440px] items-center px-8 py-4 text-[12px] text-[#7a7a7a]\" data-kid=\"1-3-1\" data-name=\"footer content row\">\n<span data-kid=\"1-3-1-1\" data-name=\"footer copyright/app name text\">Alumni Tracer Management System</span>\n</div>\n</footer>\n</div>",
