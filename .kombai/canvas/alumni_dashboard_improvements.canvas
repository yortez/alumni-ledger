ull bg-white px-5 text-[14px] font-semibold text-[#1d1d1f]\" data-kid=\"1-3-2-1\" data-name=\"operations tab (selected)\" role=\"tab\" type=\"button\">Operations</button>\n<button aria-selected=\"false\" class=\"h-9 rounded-full px-5 text-[14px] text-[#333]\" data-kid=\"1-3-2-2\" data-name=\"access tab\" role=\"tab\" type=\"button\">Access</button>\n</div>\n<section aria-label=\"Module index\" class=\"mt-7 overflow-hidden rounded-[18px] border border-[#e0e0e0] bg-white\" data-kid=\"1-3-3\" data-name=\"module index section card\">\n<div class=\"grid grid-cols-[272px_300px_448px_212px] items-center border-b border-[#e0e0e0] px-6 py-4 text-[12px] text-[#7a7a7a]\" data-kid=\"1-3-3-1\" data-name=\"table header row\">\n<span data-kid=\"1-3-3-1-1\" data-name=\"table column header: Module\">Module</span>\n<span data-kid=\"1-3-3-1-2\" data-name=\"table column header: Measures\">Measures</span>\n<span data-kid=\"1-3-3-1-3\" data-name=\"table column header: Function\">Function</span>\n<span data-kid=\"1-3-3-1-4\" data-name=\"table column header: Destination\">Destination</span>\n<!-- column widths are set on the grid container -->\n</div>\n<div class=\"divide-y divide-[#f0f0f0]\" data-kid=\"1-3-3-2\" data-name=\"table body rows container\">\n<article class=\"grid min-h-[88px] grid-cols-[272px_300px_448px_212px] items-center px-6 py-4\" data-kid=\"1-3-3-2-1\" data-name=\"module row: Graduates\">\n<h2 class=\"text-[21px] font-semibold tracking-[-0.011em]\" data-kid=\"1-3-3-2-1-1\" data-name=\"module name heading: Graduates\">Graduates</h2>\n<div class=\"pr-6\" data-kid=\"1-3-3-2-1-2\" data-name=\"module measures container\">\n<p class=\"flex items-baseline gap-2\" data-kid=\"1-3-3-2-1-2-1\" data-name=\"graduate records metric row\"><span class=\"text-[24px] font-semibold leading-none tabular-nums tracking-[-0.015em]\" data-kid=\"1-3-3-2-1-2-1-1\" data-name=\"graduate records count\">1,284</span><span class=\"text-[13px] text-[#7a7a7a]\" data-kid=\"1-3-3-2-1-2-1-2\" data-name=\"graduate records metric label\">Graduate records</span></p>\n<p class=\"mt-2 flex items-baseline gap-2\" data-kid=\"1-3-3-2-1-2-2\" data-name=\"accounts claimed metric row\"><span class=\"text-[24px] font-semibold leading-none tabular-nums tracking-[-0.015em]\" data-kid=\"1-3-3-2-1-2-2-1\" data-name=\"accounts claimed count\">963</span><span class=\"text-[13px] text-[#7a7a7a]\" data-kid=\"1-3-3-2-1-2-2-2\" data-name=\"accounts claimed metric label\">Accounts claimed</span></p>\n</div>\n<p class=\"pr-8 text-[15px] leading-[1.47] text-[#333]\" data-kid=\"1-3-3-2-1-3\" data-name=\"module description text\">Search, update, and import graduate records.</p>\n<a class=\"inline-flex items-center gap-1 text-[14px] font-semibold text-[#0066cc]\" data-kid=\"1-3-3-2-1-4\" data-name=\"module action link: Open master list\" href=\"#\">Open master list<i aria-hidden=\"true\" class=\"icon-chevron-right\" data-kid=\"1-3-3-2-1-4-1\" data-name=\"chevron right icon\"></i></a>\n</article>\n<article class=\"grid min-h-[88px] grid-cols-[272px_300px_448px_212px] items-center px-6 py-4\" data-kid=\"1-3-3-2-2\" data-name=\"module row: Announcements\">\n<h2 class=\"text-[21px] font-semibold tracking-[-0.011em]\" data-kid=\"1-3-3-2-2-1\" data-name=\"module name heading: Announcements\">Announcements</h2>\n<div data-kid=\"1-3-3-2-2-2\" data-name=\"empty measures cell\"></div>\n<p class=\"pr-8 text-[15px] leading-[1.47] text-[#333]\" data-kid=\"1-3-3-2-2-3\" data-name=\"module description text\">Create and publish announcements for alumni.</p>\n<a class=\"inline-flex items-center gap-1 text-[14px] font-semibold text-[#0066cc]\" data-kid=\"1-3-3-2-2-4\" data-name=\"module action link: Manage announcements\" href=\"#\">Manage announcements<i aria-hidden=\"true\" class=\"icon-chevron-right\" data-kid=\"1-3-3-2-2-4-1\" data-name=\"chevron right icon\"></i></a>\n</article>\n<article class=\"grid min-h-[88px] grid-cols-[272px_300px_448px_212px] items-center px-6 py-4\" data-kid=\"1-3-3-2-3\" data-name=\"module row: Surveys\">\n<h2 class=\"text-[21px] font-semibold tracking-[-0.011em]\" data-kid=\"1-3-3-2-3-1\" data-name=\"module name heading: Surveys\">Surveys</h2>\n<p class=\"flex items-baseline gap-2 pr-6\" data-kid=\"1-3-3-2-3-2\" data-name=\"open surveys metric row\"><span class=\"text-[24px] font-semibold leading-none tabular-nums tracking-[-0.015em]\" data-kid=\"1-3-3-2-3-2-1\" data-name=\"open surveys count\">3</span><span class=\"text-[13px] text-[#7a7a7a]\" data-kid=\"1-3-3-2-3-2-2\" data-name=\"open surveys metric label\">Open surveys</span></p>\n<p class=\"pr-8 text-[15px] leading-[1.47] text-[#333]\" data-kid=\"1-3-3-2-3-3\" data-name=\"module description text\">Set audiences, review responses, and close surveys.</p>\n<a class=\"inline-flex items-center gap-1 text-[14px] font-semibold text-[#0066cc]\" data-kid=\"1-3-3-2-3-4\" data-name=\"module action link: Manage surveys\" href=\"#\">Manage surveys<i aria-hidden=\"true\" class=\"icon-chevron-right\" data-kid=\"1-3-3-2-3-4-1\" data-name=\"chevron right icon\"></i></a>\n</article>\n<article class=\"grid min-h-[88px] grid-cols-[272px_300px_448px_212px] items-center px-6 py-4\" data-kid=\"1-3-3-2-4\" data-name=\"module row: Jobs\">\n<h2 class=\"text-[21px] font-semibold tracking-[-0.011em]\" data-kid=\"1-3-3-2-4-1\" data-name=\"module name heading: Jobs\">Jobs</h2>\n<p class=\"flex items-baseline gap-2 pr-6\" data-kid=\"1-3-3-2-4-2\" data-name=\"active jobs metric row\"><span class=\"text-[24px] font-semibold leading-none tabular-nums tracking-[-0.015em]\" data-kid=\"1-3-3-2-4-2-1\" data-name=\"active jobs count\">7</span><span class=\"text-[13px] text-[#7a7a7a]\" data-kid=\"1-3-3-2-4-2-2\" data-name=\"active jobs metric label\">Active jobs</span></p>\n<p class=\"pr-8 text-[15px] leading-[1.47] text-[#333]\" data-kid=\"1-3-3-2-4-3\" data-name=\"module description text\">Publish opportunities and review applications.</p>\n<a class=\"inline-flex items-center gap-1 text-[14px] font-semibold text-[#0066cc]\" data-kid=\"1-3-3-2-4-4\" data-name=\"module action link: Manage jobs\" href=\"#\">Manage jobs<i aria-hidden=\"true\" class=\"icon-chevron-right\" data-kid=\"1-3-3-2-4-4-1\" data-name=\"chevron right icon\"></i></a>\n</article>\n</div>\n</section>\n</main>\n<footer class=\"mt-auto border-t border-[#e0e0e0]\" data-kid=\"1-4\" data-name=\"footer bar\">\n<div class=\"mx-auto flex max-w-[1440px] items-center px-8 py-4 text-[12px] text-[#7a7a7a]\" data-kid=\"1-4-1\" data-name=\"footer content row\">\n<span data-kid=\"1-4-1-1\" data-name=\"footer application title text\">Alumni Tracer Management System</span>\n</div>\n</footer>\n</div>",
