in=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\"><rect height=\"12.5\" rx=\"2.5\" width=\"18\" x=\"3\" y=\"7.5\"></rect><path d=\"M9 7.5V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1.5\"></path><path d=\"M3 12.5h18\"></path></svg>\n</span>\n<span class=\"text-[13px] text-[#7a7a7a]\" data-kid=\"1-1-3-2-6-3-1-1-2-2\" data-name=\"category label text\">Application</span>\n</div>\n<h2 class=\"mt-3.5 text-[17px] font-semibold leading-[1.3]\" data-kid=\"1-1-3-2-6-3-1-1-3\" data-name=\"notification card title\">Submitted</h2>\n<p class=\"mt-2 text-[17px] font-normal leading-[1.44] text-[#333333]\" data-kid=\"1-1-3-2-6-3-1-1-4\" data-name=\"notification card description\">Your application for Research Assistant at the Institute for Data Science was received.</p>\n<div class=\"mt-5 flex flex-wrap items-center justify-between gap-3\" data-kid=\"1-1-3-2-6-3-1-1-5\" data-name=\"notification card footer\">\n<p class=\"text-[13px] text-[#7a7a7a] tabular-nums\" data-kid=\"1-1-3-2-6-3-1-1-5-1\" data-name=\"timestamp text\">13:30</p>\n<a class=\"inline-flex h-8 items-center rounded-full border border-[#e0e0e0] bg-white px-3.5 text-[15px] font-semibold leading-none text-[#0066cc]\" data-kid=\"1-1-3-2-6-3-1-1-5-2\" data-name=\"track application link\" href=\"#\">Track application</a>\n</div>\n</article>\n</div>\n<div data-kid=\"1-1-3-2-6-3-2\" data-name=\"empty column spacer\"></div>\n</div>\n</section>\n</div>\n</div>\n<div class=\"mt-12 flex items-center justify-end gap-1.5\" data-kid=\"1-1-4\" data-name=\"pagination bar\">\n<a aria-label=\"Newer notifications\" class=\"grid size-9 place-items-center rounded-full border border-[#e0e0e0] bg-white text-[#7a7a7a]\" data-kid=\"1-1-4-1\" data-name=\"previous page button\" href=\"#\">\n<svg aria-hidden=\"true\" class=\"size-4\" data-kid=\"1-1-4-1-1\" data-name=\"chevron left arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"m15 5-7 7 7 7\"></path></svg>\n</a>\n<a aria-current=\"page\" class=\"grid size-9 place-items-center rounded-full bg-[#1d1d1f] text-[15px] font-semibold leading-none text-white tabular-nums\" data-kid=\"1-1-4-2\" data-name=\"current page number\" href=\"#\">1</a>\n<a class=\"grid size-9 place-items-center rounded-full border border-[#e0e0e0] bg-white text-[15px] leading-none text-[#333333] tabular-nums\" data-kid=\"1-1-4-3\" data-name=\"page two number link\" href=\"#\">2</a>\n<a class=\"grid size-9 place-items-center rounded-full border border-[#e0e0e0] bg-white text-[15px] leading-none text-[#333333] tabular-nums\" data-kid=\"1-1-4-4\" data-name=\"page three number link\" href=\"#\">3</a>\n<a aria-label=\"Older notifications\" class=\"grid size-9 place-items-center rounded-full border border-[#e0e0e0] bg-white text-[#7a7a7a]\" data-kid=\"1-1-4-5\" data-name=\"next page button\" href=\"#\">\n<svg aria-hidden=\"true\" class=\"size-4\" data-kid=\"1-1-4-5-1\" data-name=\"chevron right arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\"><path d=\"m9 5 7 7-7 7\"></path></svg>\n</a>\n</div>\n</div>\n</div>\n",
