      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');\n</style>\n<div class=\"min-h-screen bg-[#f5f5f7] font-['Inter',sans-serif] text-[#1d1d1f]\" data-kid=\"1\" data-name=\"notifications page container\">\n<div class=\"mx-auto w-full max-w-[1440px] px-5 pb-20 pt-10 sm:px-8 xl:px-20\" data-kid=\"1-1\" data-name=\"page content wrapper\">\n<div class=\"flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-1-1\" data-name=\"page header with title and action\">\n<h1 class=\"text-[40px] font-semibold leading-none tracking-[-0.022em]\" data-kid=\"1-1-1-1\" data-name=\"page title heading\">Notifications</h1>\n<button class=\"inline-flex h-9 shrink-0 items-center justify-center rounded-full border border-[#e0e0e0] bg-white px-4 text-[17px] font-semibold leading-none text-[#1d1d1f] transition hover:border-[#d2d2d7]\" data-kid=\"1-1-1-2\" data-name=\"mark all as read button\" type=\"button\">Mark all as read</button>\n</div>\n<div class=\"mt-8 border-b border-[#e0e0e0]\" data-kid=\"1-1-2\" data-name=\"filter tabs bar container\">\n<div class=\"grid grid-cols-[108px_minmax(0,1fr)]\" data-kid=\"1-1-2-1\" data-name=\"filter tabs grid layout\">\n<div aria-hidden=\"true\" data-kid=\"1-1-2-1-1\" data-name=\"filter tabs left spacer\"></div>\n<div class=\"grid grid-cols-[minmax(0,55fr)_minmax(0,45fr)] items-start gap-x-4 pl-5\" data-kid=\"1-1-2-1-2\" data-name=\"filter tabs content row\">\n<div class=\"-mb-px\" data-kid=\"1-1-2-1-2-1\" data-name=\"tab wrapper\">\n<button class=\"flex w-full items-baseline gap-2 border-b border-[#1d1d1f] pb-3 text-left text-[17px] font-semibold leading-none text-[#1d1d1f]\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"active tab button, your record\" type=\"button\">\n                            Your record <span class=\"text-[15px] font-normal text-[#7a7a7a] tabular-nums\" data-kid=\"1-1-2-1-2-1-1-1\" data-name=\"tab new item count badge\">2 new</span>\n</button>\n</div>\n<div class=\"-mb-px\" data-kid=\"1-1-2-1-2-2\" data-name=\"tab wrapper\">\n<button class=\"flex w-full items-baseline gap-2 border-b border-transparent pb-3 text-left text-[17px] font-normal leading-none text-[#333333]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-2-1\" data-name=\"tab button\" data-reason=\"false\" type=\"button\">\n                            Broadcasts <span class=\"text-[15px] text-[#7a7a7a] tabular-nums\" data-kid=\"1-1-2-1-2-2-1-1\" data-name=\"tab new item count badge\">1 new</span>\n</button>\n</div>\n</div>\n</div>\n</div>\n<div class=\"relative mt-9\" data-kid=\"1-1-3\" data-name=\"notifications timeline container\">\n<span aria-hidden=\"true\" class=\"absolute bottom-0 left-[108px] top-0 w-px bg-[#e0e0e0]\" data-kid=\"1-1-3-1\" data-name=\"vertical timeline line\"></span>\n<div class=\"space-y-9\" data-kid=\"1-1-3-2\" data-name=\"notification groups container\">\n<!-- Today -->\n<section class=\"relative grid grid-cols-[108px_minmax(0,1fr)]\" data-kid=\"1-1-3-2-1\" data-name=\"today group section\">\n<div class=\"pt-0.5 pr-4 text-right\" data-kid=\"1-1-3-2-1-1\" data-name=\"today label wrapper\">\n<p class=\"text-[13px] font-semibold leading-tight text-[#7a7a7a] tabular-nums\" data-kid=\"1-1-3-2-1-1-1\" data-name=\"today date label\">Today</p>\n</div>\n<span aria-hidden=\"true\" class=\"absolute left-[92px] top-[7px] h-px w-[16px] bg-[#e0e0e0]\" data-kid=\"1-1-3-2-1-2\" data-name=\"group label connector line\"></span>\n<div class=\"grid grid-cols-[minmax(0,55fr)_minmax(0,45fr)] items-start gap-x-4 pl-5\" data-kid=\"1-1-3-2-1-3\" data-name=\"group two-column layout\">\n<div class=\"space-y-4\" data-kid=\"1-1-3-2-1-3-1\" data-name=\"notification card column\">\n<article class=\"relative rounded-[18px] border border-[#e0e0e0] bg-[#eef4fb] p-6\" data-kid=\"1-1-3-2-1-3-1-1\" data-name=\"unread notification card\">\n<span aria-hidden=\"true\" class=\"absolute -left-[23px] top-[36px] size-[7px] rounded-full bg-[#0066cc]\" data-kid=\"1-1