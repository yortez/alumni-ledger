ader row\">\n<div class=\"flex min-w-0 items-center gap-2.5\" data-kid=\"1-1-2-2-6-3-1-1\" data-name=\"notification category with title\">\n<svg aria-hidden=\"true\" class=\"size-4 shrink-0 text-[#7a7a7a]\" data-kid=\"1-1-2-2-6-3-1-1-1\" data-name=\"survey checklist icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\"><path d=\"m3 6 1.6 1.6L7.5 4.8\"></path><path d=\"M11 6h9\"></path><path d=\"m3 12 1.6 1.6L7.6 10.8\"></path><path d=\"M11 12h9\"></path><path d=\"m3 18 1.6 1.6L7.6 16.8\"></path><path d=\"M11 18h9\"></path></svg>\n<span class=\"truncate text-[16px] text-[#333333]\" data-kid=\"1-1-2-2-6-3-1-1-2\" data-name=\"notification title text\">Career mobility survey</span>\n</div>\n<div class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-1-2-2-6-3-1-2\" data-name=\"notification time and disclosure controls\">\n<span class=\"text-[13px] tabular-nums text-[#7a7a7a]\" data-kid=\"1-1-2-2-6-3-1-2-1\" data-name=\"notification time label\">16:22</span>\n<svg aria-hidden=\"true\" class=\"size-3.5 shrink-0 rotate-90 text-[#7a7a7a]\" data-kid=\"1-1-2-2-6-3-1-2-2\" data-name=\"expanded disclosure chevron icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\"><path d=\"m9 5 7 7-7 7\"></path></svg>\n</div>\n</div>\n<div class=\"mb-2 mt-1 rounded-[8px] bg-[#fafafc] p-4\" data-kid=\"1-1-2-2-6-3-2\" data-name=\"expanded notification detail panel\">\n<p class=\"max-w-[60ch] text-[17px] leading-[1.45] text-[#333333]\" data-kid=\"1-1-2-2-6-3-2-1\" data-name=\"notification body message text\">Five questions about your current role and how you found it. This survey closed on October 16 and no longer accepts responses.</p>\n<div class=\"mt-3 flex flex-wrap items-center justify-between gap-3\" data-kid=\"1-1-2-2-6-3-2-2\" data-name=\"notification detail footer row\">\n<p class=\"text-[13px] tabular-nums text-[#7a7a7a]\" data-kid=\"1-1-2-2-6-3-2-2-1\" data-name=\"notification full date-time caption\">21 October 2026, 16:22</p>\n<a class=\"inline-flex items-center gap-1 text-[15px] font-semibold text-[#0066cc]\" data-kid=\"1-1-2-2-6-3-2-2-2\" data-name=\"view survey results call-to-action link\" href=\"#\">View survey results<svg aria-hidden=\"true\" class=\"size-3 shrink-0\" data-kid=\"1-1-2-2-6-3-2-2-2-1\" data-name=\"link forward arrow icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\"><path d=\"m9 5 7 7-7 7\"></path></svg></a>\n</div>\n</div>\n</div>\n</li>\n<!-- 6 · OCT 02 · Announcement · read -->\n<li class=\"grid grid-cols-[72px_18px_minmax(0,1fr)] gap-x-4 border-t border-dotted border-[#f0f0f0] py-0.5\" data-kid=\"1-1-2-2-7\" data-name=\"read announcement notification row (last)\">\n<div class=\"pt-[9px]\" data-kid=\"1-1-2-2-7-1\" data-name=\"notification date column\">\n<p class=\"text-[11px] font-semibold uppercase leading-[1.2] tracking-[0.06em] text-[#7a7a7a]\" data-kid=\"1-1-2-2-7-1-1\" data-name=\"notification month label\">Oct</p>\n<p class=\"mt-1 text-[15px] font-semibold leading-[1.2] tabular-nums\" data-kid=\"1-1-2-2-7-1-2\" data-name=\"notification day number\">02</p>\n</div>\n<div class=\"relative flex justify-center self-stretch pt-[15px]\" data-kid=\"1-1-2-2-7-2\" data-name=\"notification timeline rail column (final)\">\n<span aria-hidden=\"true\" class=\"absolute -top-1 left-1/2 h-[calc(100%+4px)] w-px -translate-x-1/2 bg-[#e0e0e0]\" data-kid=\"1-1-2-2-7-2-1\" data-name=\"timeline vertical connector line (final)\"></span>\n<span class=\"relative size-1.5 border border-[#d2d2d7] bg-white\" data-kid=\"1-1-2-2-7-2-2\" data-name=\"read timeline dot indicator (final)\"></span>\n</div>\n<div class=\"min-w-0\" data-kid=\"1-1-2-2-7-3\" data-name=\"notification content column\">\n<div class=\"flex h-9 items-center justify-between gap-4\" data-kid=\"1-1-2-2-7-3-1\" data-name=\"notification header row\">\n<div class=\"flex min-w-0 items-center gap-2.5\" data-kid=\"1-1-2-2-7-3-1-1\" data-name=\"notification category with title\">\n<svg aria-hidden=\"true\" class=\"size-4 shrink-0 text-[#7a7a7a]\" data-kid=\"1-1-2-2-7-3-1-1-1\" data-name=\"announcement megaphone icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\"><path d=\"m3 10 12-5v14L3 14z\"></path><path d=\"M15 9a3 3 0 0 1 0 6\"></path><path d=\"M6 14.5V18a2 2 0 0 0 2 2h1\"></path></svg>\n<span class=\"truncate text-[16px] text-[#333333]\" data-kid=\"1-1-2-2-7-3-1-1-2\" data-name=\"notification title text\">Alumni ID renewal at the registrar</span>\n</div>\n<div class=\"flex shrink-0 items-center gap-3\" data-kid=\"1-1-2-2-7-3-1-2\" data-name=\"notification time and disclosure controls\">\n<span class=\"text-[13px] tabular-nums text-[#7a7a7a]\" data-kid=\"1-1-2-2-7-3-1-2-1\" data-name=\"notification time label\">13:30</span>\n<svg aria-hidden=\"true\" class=\"size-3.5 shrink-0 text-[#7a7a7a]\" data-kid=\"1-1-2-2-7-3-1-2-2\" data-name=\"collapsed disclosure chevron icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\"><path d=\"m9 5 7 7-7 7\"></path></svg>\n</div>\n</div>\n</div>\n</li>\n</ul>\n<div class=\"flex items-center justify-between border-t border-[#e0e0e0] px-4 py-3\" data-kid=\"1-1-2-3\" data-name=\"notifications pagination bar\">\n<p class=\"text-[13px] tabular-nums text-[#7a7a7a]\" data-kid=\"1-1-2-3-1\" data-name=\"pagination status label\">Page 1 of 2</p>\n<div class=\"flex items-center gap-1.5\" data-kid=\"1-1-2-3-2\" data-name=\"pagination page controls\">\n<span aria-disabled=\"true\" class=\"grid size-9 place-items-center rounded-full border border-[#f0f0f0] text-[#d2d2d7]\" data-kid=\"1-1-2-3-2-1\" data-name=\"disabled previous page button\">\n<svg aria-hidden=\"true\" class=\"size-4\" data-kid=\"1-1-