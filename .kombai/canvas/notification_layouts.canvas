      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n</style>\n<div class=\"min-h-screen bg-[#f5f5f7] text-[#1d1d1f] antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family: Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;\">\n<div class=\"mx-auto w-full max-w-[1440px] px-5 pb-20 pt-10 sm:px-8 xl:px-20\" data-kid=\"1-1\" data-name=\"centered page content wrapper\">\n<!-- Page header -->\n<div class=\"flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-1-1\" data-name=\"page header with title and actions\">\n<h1 class=\"text-[40px] font-semibold leading-[1.1] tracking-[-0.022em]\" data-kid=\"1-1-1-1\" data-name=\"notifications page heading\">Notifications</h1>\n<div class=\"flex items-center gap-4\" data-kid=\"1-1-1-2\" data-name=\"header actions group\">\n<p class=\"text-[13px] tabular-nums text-[#7a7a7a]\" data-kid=\"1-1-1-2-1\" data-name=\"unread notifications count label\">3 unread</p>\n<button class=\"inline-flex h-10 items-center rounded-full border border-[#e0e0e0] bg-white px-5 text-[15px] font-semibold text-[#1d1d1f] transition-colors hover:border-[#d2d2d7]\" data-kid=\"1-1-1-2-2\" data-name=\"mark all as read button\" type=\"button\">Mark all as read</button>\n</div>\n</div>\n<!-- Timeline spine -->\n<div class=\"mt-10\" data-kid=\"1-1-2\" data-name=\"timeline group of date sections\">\n<!-- Today -->\n<section class=\"grid grid-cols-[72px_minmax(0,1fr)] sm:grid-cols-[112px_minmax(0,1fr)]\" data-kid=\"1-1-2-1\" data-name=\"today date section\">\n<div class=\"relative border-r border-[#e0e0e0]\" data-kid=\"1-1-2-1-1\" data-name=\"date label timeline gutter\">\n<span class=\"absolute right-5 top-0 -translate-y-1/2 text-[13px] font-semibold tabular-nums text-[#7a7a7a]\" data-kid=\"1-1-2-1-1-1\" data-name=\"today date label\">Today</span>\n</div>\n<div class=\"border-t border-[#e0e0e0]\" data-kid=\"1-1-2-1-2\" data-name=\"today notifications list\">\n<article class=\"relative border-b border-[#f0f0f0] bg-[#fafafc] px-5 py-5\" data-kid=\"1-1-2-1-2-1\" data-name=\"unread announcement notification card\">\n<span aria-hidden=\"true\" class=\"absolute bottom-0 left-0 top-[32px] w-[2px] -translate-x-1/2 bg-[#0066cc]\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"unread timeline connector line\"></span>\n<span aria-hidden=\"true\" class=\"absolute left-0 top-7 size-[9px] -translate-x-1/2 rounded-full bg-[#0066cc]\" data-kid=\"1-1-2-1-2-1-2\" data-name=\"unread timeline dot marker\"></span>\n<p class=\"flex items-center gap-2 text-[13px] text-[#7a7a7a]\" data-kid=\"1-1-2-1-2-1-3\" data-name=\"announcement category label\">\n<svg aria-hidden=\"true\" class=\"size-4 shrink-0\" data-kid=\"1-1-2-1-2-1-3-1\" data-name=\"announcement bell icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\"><path d=\"m3 11 18-5v12L3 14v-3z\"></path><path d=\"M11.6 16.8a3 3 0 1 1-5.8-1.6\"></path></svg>\n              Announcement\n            </p>\n<div class=\"mt-2 flex items-start justify-between gap-6\" data-kid=\"1-1-2-1-2-1-4\" data-name=\"title and time row\">\n<h2 class=\"text-[17px] font-semibold leading-snug\" data-kid=\"1-1-2-1-2-1-4-1\" data-name=\"notification title\">Alumni homecoming 2026</h2>\n<time class=\"shrink-0 text-[13px] tabular-nums text-[#7a7a7a]\" data-kid=\"1-1-2-1-2-1-4-2\" data-name=\"notification timestamp\" datetime=\"2026-10-29T09:12\">09:12</time>\n</div>\n<p class=\"mt-2.5 max-w-[68ch] text-[17px] leading-[1.47] text-[#333333]\" data-kid=\"1-1-2-1-2-1-5\" data-name=\"notification body text\">Registration for the December 12 homecoming closes on November 21. Reserve a seat through the alumni office.</p>\n<a class=\"mt-2.5 inline-flex items-center gap-1 text-[15px] font-semibold text-[#0066cc] transition-colors hover:text-[#0071e3]\" data-kid=\"1-1-2-1-2-1-6\" data-name=\"view announcement link\" href=\"#\">View announcement<svg aria-hidden=\"true\" class=\"size-3 shrink-0\" data-kid=\"1-1-2-1-2-1-6-1\" data-name=\"right-pointing chevron icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" viewbox=\"0 0 24 24\"><path d=\"m9 5 7 7-7 7\"></path></svg></a>\n</article>\n<article class=\"relative border-b border-[#f0f0f0] bg-[#fafafc] px-5 py-5\" data-kid=\"1-1-2-1-2-2\" data-name=\"unread survey notification card\">\n<span aria-hidden=\"true\" class=\"absolute left-0 top-0 h-[32px] w-[2px] -translate-x-1/2 bg-[#0066cc]\" data-kid=\"1-1-2-1-2-2-1\" data-name=\"unread timeline connector line\"></span>\n<span aria-hidden=\"true\" class=\"absolute left-0 top-7 size-[9px] -translate-x-1/2 rounded-full bg-[#0066cc]\" data-kid=\"1-1-2-1-2-2-2\" data-name=\"unread timeline dot marker\"></span>\n<p class=\"flex items-center gap-2 text-[13px] text-[#7a7a7a]\" data-kid=\"1-1-2-1-2-2-3\" data-name=\"survey category label\">\n<svg aria-hidden=\"true\" class=\"size-4 shrink-0\" data-kid=\"1-1-2-1-2-2-3-1\" data-name=\"document survey icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\"><rect height=\"4\" rx=\"1\" width=\"8\" x=\"8\" y=\"2\"></rect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"></path><path d=\"M8 11h8M8 15h6\"></path></svg>\n              Survey\n            </p>\n<div class=\"mt-2 flex items-start justify-between gap-6\" data-kid=\"1-1-2-1-2-2-4\" data-name=\"title and time row\">\n<h2 class=\"text-[17px] font-semibold leading-snug\" data-kid=\"1-1-2-1-2-2-4-1\" data-name=\"notification title\">Graduate outcomes survey 2026</h2>\n<time class=\"shrink-0 text-[13px] tabular-nums text-[#7a7a7a]\" data-kid=\"1-1-2-1-2-2-4-2\" data-name=\"notification timestamp\" datetime=\"2026-10-29T08:40\">08:40</time>\n</div>\n<p class=\"mt-2.5 max-w-[68ch] text-[17px] leading-[1.47] text-[#333333]\" data-kid=\"1-1-2-1-2-2-5\" data-name=\"notification body text\">Fourth quarter survey for BS Computer Science graduates. Nine questions. Closes November 30.</p>\n<a class=\"mt-2.5 inline-flex items-center gap-1 text-[15px] font-semibold text-[#0066cc] transition-colors hover:text-[#0071e3]\" data-kid=\"1-1-2-1-2-2-6\" data-name=\"respond link\" href=\"#\">Respond<svg aria-hidden=\"true\" class=\"size-3 shrink-0\" data-kid=\"1-1-2-1-2-2-6-1\" data-name=\"right-pointing chevron icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" viewbox=\"0 0 24 24\"><path d=\"m9 5 7 7-7 7\"></path></svg></a>\n</article>\n</div>\n</section>\n<!-- 27 October -->\n<section class=\"grid grid-cols-[72px_minmax(0,1fr)] sm:grid-cols-[112px_minmax(0,1fr)]\" data-kid=\"1-1-2-2\" data-name=\"27 October date section\">\n<div class=\"relative border-r border-[#e0e0e0]\" data-kid=\"1-1-2-2-1\" data-name=\"date label timeline gutter\">\n<span class=\"absolute right-5 top-0 -translate-y-1/2 text-[13px] font-semibold tabular-nums text-[#7a7a7a]\" data-kid=\"1-1-2-2-1-1\" data-name=\"27 October date label\">27 October</span>\n</div>\n<div class=\"border-t border-[#e0e0e0]\" data-kid=\"1-1-2-2-2\" data-name=\"27 October notifications list\">\n<article class=\"relative border-b border-[#f0f0f0] bg-[#fafafc] px-5 py-5\" data-kid=\"1-1-2-2-2-1\" data-name=\"already-read application notification card\">\n<span aria-hidden=\"true\" class=\"absolute left-0 top-7 size-[9px] -translate-x-1/2 rounded-full bg-[#0066cc]\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"read timeline dot marker\"></span>\n<p class=\"flex items-center gap-2 text-[13px] text-[#7a7a7a]\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"application category label\">\n<svg aria-hidden=\"true\" class=\"size-4 shrink-0\" data-kid=\"1-1-2-2-2-1-2-1\" data-name=\"application folder icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\"><rect height=\"14\" rx=\"2\" width=\"20\" x=\"2\" y=\"7\"></rect><path d=\"M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\"></path></svg>\n              Application\n            </p>\n<div class=\"mt-2 flex items-start justify-between gap-6\" data-kid=\"1-1-2-2-2-1-3\" data-name=\"title and time row\">\n<h2 class=\"text-[17px] font-semibold leading-snug\" data-kid=\"1-1-2-2-2-1-3-1\" data-name=\"notification title\">Interview scheduled</h2>\n<time class=\"shrink-0 text-[13px] tabular-nums text-[#7a7a7a]\" data-kid=\"1-1-2-2-2-1-3-2\" data-name=\"notification timestamp\" datetime=\"2026-10-27T14:05\">14:05</time>\n</div>\n<p class=\"mt-2.5 max-w-[68ch] text-[17px] leading-[1.47] text-[#333333]\" data-kid=\"1-1-2-2-2-1-4\" data-name=\"notification body text\">Your application for Research Assistant at the Institute for Data Science moved to Interview scheduled.</p>\n<a class=\"mt-2.5 inline-flex items-center gap-1 text-[15px] font-semibold text-[#0066cc] transition-colors hover:text-[#0071e3]\" data-kid=\"1-1-2-2-2-1-5\" data-name=\"view job posting link\" href=\"#\">View job posting<svg aria-hidden=\"true\" class=\"size-3 shrink-0\" data-kid=\"1-1-2-2-2-1-5-1\" data-name=\"right-pointing chevron icon\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" viewbox=\"0 0 24 24\"><path d=\"m9 5 7 7-7 7\"></path></svg></a>\n</article>\n</div>\n</section>\n<!-- 21 October -->\n<section class=\"grid grid-cols-[72px_minmax(0,1fr)] sm:grid-cols-[112px_minmax(0,1fr)]\" data-kid=\"1-1-2-3\" data-name=\"21 October date section\">\n<div class=\"relative border-r border-[#e0e0e0]\" data-kid=\"1-1-2-3-1\" data-name=\"date label timeline gutter\">\n<span class=\"absolute right-5 top-0 -translate-y-1/2 text-[13px] font-semibold tabular-nums text-[#7a7a7a]\" data-kid=\"1-1-2-3-1-1\" data-name=\"21 October date label\">21 October</span>\n</div>\n<div class=\"border-t border-[#e0e0e0]\" data-kid=\